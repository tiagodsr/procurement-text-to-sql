# Copy to .env and fill in. Never commit .env.

# OpenAI key. Unit tests never need it.
OPENAI_API_KEY=

# Models (defaults shown). Every model used must have a price in config/pricing.toml.
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_S=30

# Admin password of the db container, used only by the init scripts (local default shown).
POSTGRES_PASSWORD=postgres_local

# Read-only application connection (role app_ro, documented local password), on the loopback
# port published by docker-compose.yml. Inside compose the host is `db:5432`.
DATABASE_URL=postgresql://app_ro:app_ro_local@127.0.0.1:55432/procurement
