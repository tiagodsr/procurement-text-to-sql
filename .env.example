# Copy to .env and fill in. Never commit .env.

# OpenAI key. Only the api service receives it. Unit tests never need it.
OPENAI_API_KEY=

# Models (defaults shown). Every model used must have a price in config/pricing.toml.
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_S=30

# JSONL trace events, one file per day (git-ignored). Default: var/traces under the repo.
TRACE_DIR=

# Admin password of the db container, used only by the init scripts (local default shown).
POSTGRES_PASSWORD=postgres_local

# Read-only application connection (role app_ro, documented local password).
# This is the dev loopback port from compose.dev.yml; inside compose the host is `db:5432`.
DATABASE_URL=postgresql://app_ro:app_ro_local@127.0.0.1:55432/procurement
